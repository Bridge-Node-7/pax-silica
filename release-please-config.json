{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "pax-silica",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {
          "type": "generic",
          "path": "VERSION"
        }
      ],
      "version-file": "VERSION",
      "exclude-paths": [
        "CODE_OF_CONDUCT.md",
        "CONTRIBUTING.md",
        "LICENSE",
        "README.md",
        "SECURITY.md",
        "docs"
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "security",
      "section": "Security"
    },
    {
      "type": "docs",
      "section": "Documentation",
      "hidden": true
    },
    {
      "type": "ci",
      "section": "CI"
    },
    {
      "type": "chore",
      "section": "Miscellaneous"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "test",
      "section": "Tests"
    },
    {
      "type": "deps",
      "section": "Dependencies"
    }
  ]
}
