  "claims": [
    {
      "id": "C-001",
      "state": "official",
      "workflow_state": "approved",
      "text": "Pax Silica is a U.S.-led strategic initiative focused on trusted technology and AI supply chains.",
      "source_ids": [
        "S-01"
      ],
      "verified_at": "2026-08-15",
      "public": true
    },
    {
      "id": "C-002",
      "state": "official",
      "workflow_state": "approved",
      "text": "The June 2026 quantum executive order directs recommendations for aligning Pax Silica with U.S. quantum priorities.",
      "source_ids": [
        "S-03"
      ],
      "verified_at": "2026-08-15",
      "public": true
    },
    {
      "id": "C-003",
      "state": "official",
      "workflow_state": "approved",
      "text": "The July 2026 defense-supply-chain executive order requires supply-chain illumination from raw materials to end-use products and accelerates qualification of alternative sources.",
      "source_ids": [
        "S-04"
      ],
      "verified_at": "2026-08-15",
      "public": true
    },
    {
      "id": "C-004",
      "state": "official",
      "workflow_state": "approved",
      "text": "The Pax Silica AI Assistance Project listing shows three expected awards, a $1 million minimum, a $50 million maximum, and an August 20, 2026 close date.",
      "source_ids": [
        "S-05",
        "S-06"
      ],
      "verified_at": "2026-08-15",
      "review_by": "2026-08-20",
      "public": true
    },
    {
      "id": "C-005",
      "state": "official",
      "workflow_state": "approved",
      "text": "The Philippines joined Pax Silica alongside announced plans for a roughly 4,000-acre industrial hub in the Luzon Economic Corridor.",
      "source_ids": [
        "S-07"
      ],
      "verified_at": "2026-08-15",
      "public": true
    },
    {
      "id": "C-006",
      "state": "reported_draft",
      "workflow_state": "approved",
      "text": "Reuters reported a draft U.S. approach that could pressure some partners to choose between U.S.- and China-led AI frameworks.",
      "source_ids": [
        "S-09"
      ],
      "verified_at": "2026-08-15",
