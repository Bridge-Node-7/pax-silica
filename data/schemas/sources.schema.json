{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pax Silica Source Registry",
  "type": "object",
  "required": [
    "sources"
  ],
  "properties": {
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "state",
          "publisher",
          "title",
          "url",
          "verified_at",
          "supports",
          "note"
        ]
      }
    }
  }
}
